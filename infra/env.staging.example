# Staging environment — copy to .env.staging and fill in values.
# These are pulled from the secret store in CI; this file is for manual/local staging runs.
# NEVER commit real credentials.

# ── Container registry ────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io/gpandit
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=pandit_staging
POSTGRES_USER=pandit
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── API ───────────────────────────────────────────────────────────────────────
API_SECRET_KEY=CHANGE_ME_64_random_bytes_hex

# ── Object storage (S3-compatible) ────────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.amazonaws.com        # or MinIO URL for self-hosted
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=pandit-staging

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ── Build profile (must stay staging — commercial licence gate) ───────────────
PANCHANG_BUILD_PROFILE=staging
PANCHANG_EPHEMERIS_LICENSE=agpl
