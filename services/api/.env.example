# services/api — environment variables
# Copy to services/api/.env for local dev. See root .env.example for all defaults.
API_ENVIRONMENT=development
API_DEBUG=true
API_DATABASE_URL=postgresql+asyncpg://pandit:pandit@localhost:5432/pandit_dev
API_REDIS_URL=redis://localhost:6379/0
API_SECRET_KEY=dev-secret-change-in-production
API_PANCHANG_SERVICE_URL=http://localhost:8001

# Users module — vault & OAuth (Step 2.1). Real values come from the managed
# secret store; never commit them. Generate a vault key with:
#   python -c "from api.users.encryption import VaultCipher; print(VaultCipher.generate_key())"
API_VAULT_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
API_GOOGLE_OAUTH_CLIENT_ID=
API_APPLE_OAUTH_CLIENT_ID=
