  "tieBreakSemantics": {
    "udaya_tithi": "Observe on the civil day at whose sunrise the tithi prevails. Vriddhi: first such day. Kshaya: the day on which the tithi is current at any point after sunrise (never skip).",
    "udaya_tithi_skip_if_kshaya_at_sunrise": "As udaya_tithi, but if the tithi begins after sunrise and ends before the next sunrise (kshaya), observe on the day it begins.",
    "udaya_tithi_prefer_hasta": "udaya_tithi; if two candidate days, prefer the one with preferNakshatra.",
    "tithi_at_anchor_else_next_day": "Observe on day 1 if the tithi prevails at the anchor moment; otherwise day 2 if it prevails there; if neither, the day the tithi covers more of the anchor window.",
    "tithi_at_anchor_else_prev_day": "Mirror of the above favouring the earlier day.",
    "tithi_at_anchor_else_prev_day_if_more": "If the tithi prevails at the anchor on both days, pick the day with the greater overlap of the anchor window; if only one, that day; if neither, the day whose anchor window it overlaps more.",
    "tithi_at_anchor_strict": "Only the day on which the tithi prevails at the exact anchor instant; if none, fall back to udaya_tithi.",
    "tithi_at_anchor_avoid_bhadra": "As tithi_at_anchor_else_prev_day_if_more, but the observance window excludes Vishti (Bhadra) karana; if Bhadra covers the whole anchor window, shift to the first Bhadra-free window after it on the same civil day (Bhadra puccha permitted per regional flag).",
    "tithi_at_moonrise_else_next_day": "Day on which the tithi prevails at local moonrise; if not on day 1, day 2.",
    "nakshatra_at_sunrise_else_greater_portion": "Day at whose sunrise the nakshatra prevails; otherwise the day in which it covers the greater portion of daytime.",
    "ekadashi_smarta_vaishnava": "Smarta: if Dashami prevails at arunodaya (96 min before sunrise) the fast moves to the next day. Emits both smarta and vaishnava dates when they differ; region selects which is shown.",
    "ekadashi_vaishnava": "Vaishnava-only variant.",
    "vaishnava_udaya_prefer_rohini": "Observe when Ashtami prevails at sunrise; if Rohini nakshatra coincides on an adjacent day, prefer it (Jayanti yoga).",
    "sankranti_punya_kala": "Observance day = day of the Sun's ingress instant; if ingress is after local sunset, the next day. Punya kala window per regional convention."
  },
