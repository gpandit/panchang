{
  "name": "@pandit/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design token placeholder — replaced by the Aqualeo design system",
  "type": "module",
  "main": "./tokens.placeholder.json",
  "exports": {
    ".": "./tokens.placeholder.json",
    "./schema": "./dist/schema.js",
    "./css": "./generated/tokens.css",
    "./tailwind-preset": "./generated/tailwind-preset.js"
  },
  "scripts": {
    "generate": "tsx src/generate.ts",
    "build": "tsc -p tsconfig.build.json && pnpm run generate",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "pnpm run generate && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
