# ─── The Pandit — development .env.example ────────────────────────────────────
# Copy this file to .env for local development:
#   ./deploy.sh up
#
# These credentials are intentionally local-only development defaults. Never
# expose this stack publicly or reuse these values in staging/production.
# Staging/production values belong in the managed secret store.

# ── API Gateway (services/api) ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_ENVIRONMENT=development
API_DATABASE_URL=postgresql+psycopg://pandit_app:pandit_app_dev@localhost:5432/pandit_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://pandit:pandit@localhost:5432/pandit_dev
API_REDIS_URL=redis://localhost:6379/0
API_S3_ENDPOINT_URL=http://localhost:9000
API_S3_ACCESS_KEY=minioadmin
API_S3_SECRET_KEY=minioadmin
API_S3_BUCKET=pandit-dev
API_SECRET_KEY=dev-secret-change-in-production
API_JWT_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_SECONDS=900
# Local-only credential for trusted test billing adapters.
API_SUBSCRIPTION_ADAPTER_TOKEN=dev-provider-adapter-only
API_PANCHANG_SERVICE_URL=http://localhost:8001
API_PANCHANG_SERVICE_TIMEOUT=1.5
API_ALLOWED_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST_PER_MINUTE=10
API_PANCHANG_CACHE_TTL_SECONDS=3600
API_PANCHANG_CACHE_MAX_SIZE=1024
API_PANCHANG_ENGINE_VERSION=3
API_PANCHANG_CACHE_GRID_DEGREES=0.1

# ── Panchang Computation Service (services/panchang) ─────────────────────────
PANCHANG_HOST=0.0.0.0
PANCHANG_PORT=8001
PANCHANG_DEBUG=true
PANCHANG_ENVIRONMENT=development
PANCHANG_EPHEMERIS_PATH=libs/ephemeris
PANCHANG_DEFAULT_AYANAMSA=lahiri
PANCHANG_EPHEMERIS_LICENSE=agpl
PANCHANG_BUILD_PROFILE=development
PANCHANG_DATABASE_URL=postgresql+psycopg://pandit_app:pandit_app_dev@localhost:5432/pandit_dev
PANCHANG_REDIS_URL=redis://localhost:6379/1
PANCHANG_CACHE_TTL_SECONDS=86400
PANCHANG_CACHE_GRID_DEGREES=0.1
PANCHANG_WARM_LOCATIONS_JSON=[]
PANCHANG_WARM_TOP_LOCATIONS=500
PANCHANG_FESTIVAL_RULES_PATH=

# ── Optional development worker ───────────────────────────────────────────────
WORKER_QUEUES=pdf,reminders,cache-warm
START_WORKER=0
DEV_STATE_DIR=.tmp/dev

# ── Infrastructure (docker-compose) ──────────────────────────────────────────
POSTGRES_IMAGE=postgis/postgis:16-3.4
POSTGRES_DB=pandit_dev
POSTGRES_USER=pandit
POSTGRES_PASSWORD=pandit
POSTGRES_APP_USER=pandit_app
POSTGRES_APP_PASSWORD=pandit_app_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
