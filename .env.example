# ─── The Pandit — Root .env.example ──────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env to source control.
# Staging / production values live in the managed secret store — see CONTRIBUTING.md §4.

# ── API Gateway (services/api) ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_ENVIRONMENT=development
API_DATABASE_URL=postgresql+psycopg://pandit:pandit@localhost:5432/pandit_dev
API_REDIS_URL=redis://localhost:6379/0
API_S3_ENDPOINT_URL=http://localhost:9000
API_S3_ACCESS_KEY=minioadmin
API_S3_SECRET_KEY=minioadmin
API_S3_BUCKET=pandit-dev
API_SECRET_KEY=dev-secret-change-in-production
API_PANCHANG_SERVICE_URL=http://localhost:8001

# ── Panchang Computation Service (services/panchang) ─────────────────────────
PANCHANG_HOST=0.0.0.0
PANCHANG_PORT=8001
PANCHANG_DEBUG=true
PANCHANG_ENVIRONMENT=development
PANCHANG_EPHEMERIS_PATH=../../libs/ephemeris
PANCHANG_DEFAULT_AYANAMSA=lahiri
PANCHANG_REDIS_URL=redis://localhost:6379/1
PANCHANG_CACHE_TTL_SECONDS=86400

# ── Infrastructure (docker-compose) ──────────────────────────────────────────
POSTGRES_DB=pandit_dev
POSTGRES_USER=pandit
POSTGRES_PASSWORD=pandit
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
